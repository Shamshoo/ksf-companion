<Window x:Class="KsfCompanion.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KsfCompanion.Ui"
        Title="KSF Companion" Icon="/KSFCompanion;component/Ui/Assets/app.ico" Width="1400" Height="900" MinWidth="460" MinHeight="540"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource Text0Brush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <ui:InverseVisibilityConverter x:Key="NotVis" />
        <ui:NotConverter x:Key="Not" />
        <ui:EqualsConverter x:Key="Eq" />

        <!-- A part of the dashboard you can hide: hover it for the × on its corner (Customize, top right, brings it back). -->
        <Style x:Key="Part" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid x:Name="root" Background="Transparent">
                            <ContentPresenter />
                            <Button x:Name="hide" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,14,0" Focusable="False"
                                    Command="{Binding HidePartCommand}" CommandParameter="{TemplateBinding Tag}"
                                    ToolTip="Hide this - Customize (top right) brings it back" ToolTipService.InitialShowDelay="400">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Width="22" Height="22" CornerRadius="11" Background="#F21C1C24" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8.5" Foreground="{StaticResource Text1Brush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#FF3A1A1C" />
                                                <Setter TargetName="b" Property="BorderBrush" Value="#99FF5C5C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                                <Setter TargetName="hide" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in the Customize list: the part's name and an on/off switch. -->
        <Style x:Key="SwitchRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="row" Background="Transparent" CornerRadius="7" Padding="9,6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Right" Width="32" Height="18" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border x:Name="track" CornerRadius="9" Background="{StaticResource Bg3Brush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" />
                                    <Ellipse x:Name="knob" Width="12" Height="12" Fill="{StaticResource Text2Brush}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="knob" Property="Fill" Value="#1A0E05" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The tile size slider on the nominate page: a thin track, the part up to the knob in the accent colour. -->
        <Style x:Key="SliderSpan" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SizeSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Bg3Brush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderSpan}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderSpan}" Background="Transparent" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource Text0Brush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="knob" Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The small caps label in front of a group of filter buttons: TIER, TYPE, SHOW, SORT. -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Title bar toggle (Customize): lit while its panel is open. -->
        <Style x:Key="TitleToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="7" Background="Transparent" Padding="10,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="132" />
        </Style>

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- A leaderboard chip above the leaderboard: MAP, S1..., B1...; the one on show is filled in. -->
        <Style x:Key="LeaderChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,0,5,5" Background="Transparent">
                            <Border x:Name="bg" CornerRadius="5" Background="{StaticResource Bg3Brush}" />
                            <Border x:Name="hover" CornerRadius="5" Background="#16FFFFFF" Opacity="0" />
                            <TextBlock x:Name="text" Text="{Binding Label}" Margin="9,2" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text1Brush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="text" Property="Foreground" Value="#1A0E05" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of your times (map, stage or bonus): label, time, how close it is to the record (the bar fills smoothly;
             full = record pace), the gap to the record, and your place on its leaderboard "#4,570 / 31,958". -->
        <DataTemplate x:Key="ZoneRowTemplate">
            <!-- Click a row to show its leaderboard; the arrow at the end teleports you there in game (console command: sm_stage / sm_bonus / sm_restart). -->
            <Grid x:Name="root" Margin="-8,0,-8,1" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectLeaderboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Zone}" />
                </Grid.InputBindings>
                <Border x:Name="hover" CornerRadius="9" Background="#0CFFFFFF" Opacity="0" />
                <Border x:Name="flash" CornerRadius="9" Background="#38FF7A1A" Opacity="0" />
                <Border x:Name="row" Style="{StaticResource Row}" Padding="8,5" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="700">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" MinWidth="20" />
                            <ColumnDefinition Width="Auto" MinWidth="58" />
                            <ColumnDefinition x:Name="rankColumn" Width="Auto" MinWidth="108" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="go" Grid.Column="5" Background="Transparent" Margin="0,-5,-8,-5" Padding="4,0,8,0" Opacity="0.35"
                                ToolTip="Teleport there" ToolTipService.InitialShowDelay="400">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.TeleportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Zone}" />
                            </Border.InputBindings>
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Text0Brush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="chip" CornerRadius="5" Background="{StaticResource Bg3Brush}" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="label" Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text1Brush}" />
                        </Border>
                        <TextBlock x:Name="time" Grid.Column="1" Style="{StaticResource Numbers}" Text="{Binding Time}" FontSize="14" />
                        <Grid Grid.Column="2" Height="3" Margin="2,0,14,0" VerticalAlignment="Center">
                            <Border CornerRadius="1.5" Background="{StaticResource Bg3Brush}" />
                            <Border x:Name="bar" CornerRadius="1.5" Background="#8CFF7A1A" RenderTransformOrigin="0,0.5" ui:BarFill.Value="{Binding Closeness}" />
                        </Grid>
                        <TextBlock Grid.Column="3" Style="{StaticResource Numbers}" Text="{Binding Gap}" Foreground="{Binding GapBrush}" FontSize="12.5"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="rank" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                                   Typography.NumeralAlignment="Tabular" FontSize="12">
                            <Run Text="{Binding Rank, Mode=OneWay}" Foreground="{Binding RankBrush, Mode=OneWay}" /><Run Text="{Binding RankTotal, Mode=OneWay}" Foreground="{StaticResource Text2Brush}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="False">
                    <Setter TargetName="time" Property="Foreground" Value="{StaticResource Text2Brush}" />
                </DataTrigger>
                <!-- The Simple view leaves out the leaderboard place (the map's is on "your best" above). -->
                <DataTrigger Binding="{Binding DataContext.Layout.IsSimple, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="rank" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="rankColumn" Property="MinWidth" Value="0" />
                </DataTrigger>
                <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="go" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="go" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="row" Property="BorderBrush" Value="#66FF7A1A" />
                    <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="label" Property="Foreground" Value="#1A0E05" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFresh}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="flash" Storyboard.TargetProperty="Opacity">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

<!-- Nominate page, tiles view: the map's picture, name, tier and details, and its buttons. -->
        <DataTemplate x:Key="MapTileTemplate">
            <Grid x:Name="root" Background="Transparent">
                <Border CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                <Border x:Name="hover" CornerRadius="12" Background="#0AFFFFFF" Opacity="0" />
                <Border x:Name="current" CornerRadius="12" BorderBrush="#88FF7A1A" BorderThickness="1" Visibility="Collapsed" />
                <StackPanel>
                    <ui:AspectBox Ratio="0.56" Margin="1,1,1,0">
                    <Grid>
                        <Border CornerRadius="11,11,0,0" Background="{StaticResource Bg3Brush}" />
                        <Border CornerRadius="11,11,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="11,11,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.55" />
                                    <GradientStop Color="#A0000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="5" Background="#D90B0B0F" Padding="6,1">
                            <TextBlock Text="{Binding TierText}" Foreground="{Binding TierBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="playing" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" CornerRadius="5" Background="{StaticResource AccentBrush}" Padding="6,1"
                                Visibility="Collapsed">
                            <TextBlock Text="PLAYING NOW" Foreground="#1A0E05" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="Bold" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,7"
                                    Visibility="{Binding HasRating, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="#F5C542" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Rating}" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" Margin="4,0,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,7" CornerRadius="5" Background="{StaticResource GoodBrush}" Padding="6,1,7,1"
                                Visibility="{Binding IsDone, Converter={StaticResource Vis}}" ToolTip="{Binding DoneTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="#08180F" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DoneText}" Foreground="#08180F" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ui:AspectBox>
                    <StackPanel Margin="12,9,12,11">
                        <TextBlock Text="{Binding Map}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" FontSize="11.5" Margin="0,3,0,0" />
                        <DockPanel Margin="0,9,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,5"
                                    Command="{Binding DataContext.NominateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}">
                                <TextBlock Text="Nominate" FontSize="12" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="save" Style="{StaticResource GhostButton}" Padding="9,5" ToolTip="Save it to your play-later list"
                                        Command="{Binding DataContext.ToggleSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="saveIcon" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="saveText" Text="Save" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open on ksf.surf" Margin="2,0,0,0"
                                        Command="{Binding DataContext.OpenLaterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="saveIcon" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="saveIcon" Property="Foreground" Value="#F5C542" />
                    <Setter TargetName="saveText" Property="Text" Value="Saved" />
                    <Setter TargetName="save" Property="ToolTip" Value="In your play-later list (click to take it off)" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="current" Property="Visibility" Value="Visible" />
                    <Setter TargetName="playing" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Nominate page, list view: small picture, name, tier and details in one row. -->
        <DataTemplate x:Key="MapListTemplate">
            <Grid x:Name="root" Margin="0,0,0,3" Background="Transparent">
                <Border x:Name="hover" CornerRadius="9" Background="#0CFFFFFF" Opacity="0" />
                <Border x:Name="row" Style="{StaticResource Row}" />
                <Grid Margin="7,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="{Binding DataContext.ListThumbWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.ListThumbHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border CornerRadius="7" Background="{StaticResource Bg3Brush}" />
                        <Border CornerRadius="7">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Map}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="playing" Text="playing now" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border CornerRadius="5" Padding="6,1" Background="{Binding TierSoftBrush}">
                                <TextBlock Text="{Binding TierText}" Foreground="{Binding TierBrush}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                            </Border>
                            <Border CornerRadius="5" Padding="6,1,7,1" Margin="6,0,0,0" Background="{StaticResource GoodSoftBrush}"
                                    Visibility="{Binding IsDone, Converter={StaticResource Vis}}" ToolTip="{Binding DoneTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource GoodBrush}" FontSize="9.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DoneText}" Foreground="{StaticResource GoodBrush}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                               Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" Margin="8,0,0,0" FontSize="11.5" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Mappers}" Margin="10,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                Visibility="{Binding HasRating, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="#F5C542" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Rating}" FontFamily="{StaticResource DisplayFont}" FontSize="12" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="save" Style="{StaticResource GhostButton}" Padding="10,5" ToolTip="Save it to your play-later list"
                                Command="{Binding DataContext.ToggleSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="saveIcon" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="saveText" Text="Save for later" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open on ksf.surf" Margin="4,0,0,0"
                                Command="{Binding DataContext.OpenLaterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}" />
                        <Button Style="{StaticResource AccentButton}" Padding="12,5" Margin="6,0,0,0"
                                Command="{Binding DataContext.NominateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}">
                            <TextBlock Text="Nominate" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="saveIcon" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="saveIcon" Property="Foreground" Value="#F5C542" />
                    <Setter TargetName="saveText" Property="Text" Value="Saved" />
                    <Setter TargetName="save" Property="ToolTip" Value="In your play-later list (click to take it off)" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="playing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="row" Property="BorderBrush" Value="#55FF7A1A" />
                </DataTrigger>
                <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Binds page: the key button on each row. Waiting for a key: orange; no key yet: quiet. -->
        <Style x:Key="BindKeyButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Command" Value="{Binding DataContext.Binds.CaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="Content" Value="{Binding KeyLabel}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasKey}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BindRowTemplate">
            <Grid Margin="-8,0,-8,2" Background="Transparent">
                <Border x:Name="hover" CornerRadius="9" Background="#0AFFFFFF" Opacity="0" />
                <Grid Margin="8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Help}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding Replaces}" FontSize="11" Foreground="#C9A15A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasReplaces, Converter={StaticResource Vis}}"
                                   ToolTip="What this key did in the game before - it gets that back if you take the bind off" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="0,0,10,0" Background="#0DFFFFFF">
                        <TextBlock Text="{Binding CommandText}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Text1Brush}" />
                    </Border>
                    <!-- Keys your game already has on this (your own binds in config.cfg). -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding InGame}" Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1,1,1,2" CornerRadius="7"
                                        Padding="10,3,3,3" Margin="0,0,6,0" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="500">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="20" Height="20" FontSize="8" Margin="6,0,0,0"
                                                Command="{Binding DataContext.Binds.RemoveGameKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="3" Style="{StaticResource BindKeyButton}" VerticalAlignment="Center"
                            ToolTip="Click, then press the key (or a mouse button / the wheel). Esc cancels." ToolTipService.InitialShowDelay="600" />
                    <Button x:Name="clear" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24" HorizontalAlignment="Right"
                            Command="{Binding DataContext.Binds.ClearCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            ToolTip="Take the key off (it gets back what it did before)" Visibility="Collapsed" />
                    <Button x:Name="remove" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="24" Height="24" HorizontalAlignment="Right"
                            Command="{Binding DataContext.Binds.RemoveOwnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            ToolTip="Remove this command" Visibility="Collapsed" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="hover" Property="Opacity" Value="1" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasKey}" Value="True" />
                        <Condition Binding="{Binding CanClear}" Value="True" />
                        <Condition Binding="{Binding IsOwn}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="clear" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOwn}" Value="True" />
                        <Condition Binding="{Binding HasInGame}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="remove" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The map's colours, very softly, behind everything (a tiny blurred copy of its picture). -->
            <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="Ambient" Opacity="0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding AmbientImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#AE07070A" Offset="0" />
                            <GradientStop Color="#D807070A" Offset="0.4" />
                            <GradientStop Color="#F207070A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- ============ Title bar: logo and you on the left, window controls on the right ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="26" Height="26" />
                    <TextBlock Text="KSF" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="COMPANION" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource Text2Brush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    <!-- pages -->
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                        <Button Style="{StaticResource TabButton}" Content="Dashboard" Command="{Binding ShowPageCommand}" CommandParameter="dashboard" Tag="{Binding IsDashboardPage}" />
                        <Button Style="{StaticResource TabButton}" Content="Nominate" Command="{Binding ShowPageCommand}" CommandParameter="nominate" Tag="{Binding IsNominatePage}" />
                        <Button Style="{StaticResource TabButton}" Content="Binds" Command="{Binding ShowPageCommand}" CommandParameter="binds" Tag="{Binding IsBindsPage}" />
                    </StackPanel>
                </StackPanel>

                <!-- The dot on your avatar is the CS:S connection (green = connected). Hover it for details. -->
                <StackPanel x:Name="PlayerChip" Grid.Column="1" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center" Background="Transparent"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding StatusText}" ToolTipService.InitialShowDelay="300">
                    <Grid Width="26" Height="26">
                        <Ellipse Fill="{StaticResource Bg3Brush}" />
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                 Fill="{Binding StatusBrush}" Stroke="{StaticResource Bg0Brush}" StrokeThickness="2" />
                    </Grid>
                    <TextBlock Text="{Binding PlayerLabel}" FontWeight="SemiBold" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlayerDetail}" Foreground="{StaticResource Text2Brush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <!-- Simple (the essentials, bigger and cleaner) or Advanced (every detail), and which parts are on the dashboard. -->
                    <Border CornerRadius="7" Background="#0EFFFFFF" Padding="2" VerticalAlignment="Center" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsDashboardPage, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Content="Simple" Command="{Binding SetViewCommand}" CommandParameter="simple"
                                    Tag="{Binding Layout.IsSimple}" ToolTip="The essentials, bigger and cleaner" ToolTipService.InitialShowDelay="600" />
                            <Button Style="{StaticResource SegmentButton}" Content="Advanced" Command="{Binding SetViewCommand}" CommandParameter="advanced"
                                    Tag="{Binding Layout.IsAdvanced}" ToolTip="Every detail" ToolTipService.InitialShowDelay="600" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="CustomizeButton" Style="{StaticResource TitleToggle}" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsDashboardPage, Converter={StaticResource Vis}}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=CustomizePopup, Converter={StaticResource Not}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Customize" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Layout.HiddenText}" Margin="7,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontSize="11.5" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="CustomizePopup" PlacementTarget="{Binding ElementName=CustomizeButton}" Placement="Bottom" HorizontalOffset="-150" VerticalOffset="8"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=CustomizeButton, Mode=TwoWay}">
                        <Border Width="300" Background="#FA121217" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" CornerRadius="12" Padding="10,14,10,12">
                            <StackPanel>
                                <!-- How big everything is drawn. -->
                                <DockPanel Margin="9,0,9,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Layout.ScaleText}" FontFamily="{StaticResource DisplayFont}" FontSize="12.5"
                                               Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="SIZE" Width="44" VerticalAlignment="Center" />
                                    <Slider Style="{StaticResource SizeSlider}" Minimum="0.8" Maximum="1.5" Margin="4,0,10,0" VerticalAlignment="Center"
                                            Value="{Binding Layout.Scale, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1" />
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="-10,0,-10,12" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="SHOW ON THE DASHBOARD" Margin="9,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Text="Or hover a part and click the × on its corner." Margin="9,0,0,8" FontSize="11.5" />
                                <ItemsControl ItemsSource="{Binding Layout.Parts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource SwitchRow}" Content="{Binding Label}" IsChecked="{Binding IsShown, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource GhostButton}" Content="Show everything" Command="{Binding ShowAllPartsCommand}" HorizontalAlignment="Left"
                                        Margin="9,10,0,0" Padding="12,5" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize" />
                    <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Only when something needs you (e.g. restart CS:S once to finish setup). -->
            <Border Grid.Row="1" Margin="20,0,20,8" CornerRadius="10" Background="#14F5B83D" BorderBrush="#40F5B83D" BorderThickness="1" Padding="14,9"
                    Visibility="{Binding HasNotice, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="#F5B83D" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Notice}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ============ Nominate page: rock the vote, and every KSF map to search and nominate ============ -->
            <Grid x:Name="NominatePage" Grid.Row="2" Margin="20,6,20,8" Visibility="{Binding IsNominatePage, Converter={StaticResource Vis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- What's playing and rock the vote, then the search and the filters - one card. -->
                <Border Style="{StaticResource Card}" Padding="18,14,18,12">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding RtvCommand}" VerticalAlignment="Center" Padding="16,8" Margin="16,0,0,0"
                                    ToolTipService.InitialShowDelay="500"
                                    ToolTip="Rock the vote asks the server to change the map; Nominate puts a map on the next vote. Both are sent from the console (sm_rtv, sm_nominate), so nothing is typed in chat - the server announces the votes as usual.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                                    <TextBlock Text="Rock the vote" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="PLAYING NOW" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding MapName}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Chip}" Margin="12,0,6,0" Visibility="{Binding HasLiveTime, Converter={StaticResource Vis}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding LiveTimeLeft}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding HasNextMap, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ChipText}" Text="NEXT" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding NextMap}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="-18,14,-18,14" />

                        <DockPanel>
                            <Border DockPanel.Dock="Right" Margin="12,0,0,0" CornerRadius="7" Background="{StaticResource Bg2Brush}" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SegmentButton}" Command="{Binding SetMapViewCommand}" CommandParameter="tiles" Tag="{Binding IsTileView}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xECA5;" FontSize="11" />
                                            <TextBlock Text="Tiles" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SegmentButton}" Command="{Binding SetMapViewCommand}" CommandParameter="list" Tag="{Binding IsListView}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="11" />
                                            <TextBlock Text="List" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!-- How big the tiles (and the list's pictures) are. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,6,0" VerticalAlignment="Center" Background="Transparent"
                                        ToolTip="Tile size" ToolTipService.InitialShowDelay="500">
                                <TextBlock Text="&#xE71F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                <Slider Style="{StaticResource SizeSlider}" Width="130" Minimum="200" Maximum="460" Margin="9,0" VerticalAlignment="Center"
                                        Value="{Binding TileSize, Mode=TwoWay}" SmallChange="20" LargeChange="40" />
                                <TextBlock Text="&#xE8A3;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid>
                                <TextBox x:Name="MapSearchBox" Style="{StaticResource SearchBox}" Text="{Binding MapSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Text2Brush}" Margin="13,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock Text="Search KSF maps or mappers..." Foreground="{StaticResource Text2Brush}" FontSize="14" Margin="37,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="{Binding HasMapSearch, Converter={StaticResource NotVis}}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,5,0"
                                        Command="{Binding ClearMapSearchCommand}" Visibility="{Binding HasMapSearch, Converter={StaticResource Vis}}" />
                            </Grid>
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding MapStatus}" FontSize="11.5" Margin="12,0,0,6" VerticalAlignment="Bottom" />
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FilterLabel}" Text="TIER" Margin="0,0,8,6" />
                                <Border CornerRadius="7" Background="{StaticResource Bg2Brush}" Padding="2" Margin="0,0,20,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SegmentButton}" Content="All" Command="{Binding SetMapTierCommand}" CommandParameter="0" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=0}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T1" Command="{Binding SetMapTierCommand}" CommandParameter="1" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=1}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T2" Command="{Binding SetMapTierCommand}" CommandParameter="2" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=2}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T3" Command="{Binding SetMapTierCommand}" CommandParameter="3" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=3}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T4" Command="{Binding SetMapTierCommand}" CommandParameter="4" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=4}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T5" Command="{Binding SetMapTierCommand}" CommandParameter="5" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=5}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T6" Command="{Binding SetMapTierCommand}" CommandParameter="6" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=6}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T7" Command="{Binding SetMapTierCommand}" CommandParameter="7" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=7}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="T8" Command="{Binding SetMapTierCommand}" CommandParameter="8" Tag="{Binding MapTier, Converter={StaticResource Eq}, ConverterParameter=8}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource FilterLabel}" Text="TYPE" Margin="0,0,8,6" />
                                <Border CornerRadius="7" Background="{StaticResource Bg2Brush}" Padding="2" Margin="0,0,20,6"
                                        ToolTip="Linear maps (one run with checkpoints) or staged maps (separate stages)" ToolTipService.InitialShowDelay="700">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SegmentButton}" Content="Any" Command="{Binding SetMapKindCommand}" CommandParameter="all" Tag="{Binding MapKind, Converter={StaticResource Eq}, ConverterParameter=all}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Linear" Command="{Binding SetMapKindCommand}" CommandParameter="linear" Tag="{Binding MapKind, Converter={StaticResource Eq}, ConverterParameter=linear}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Staged" Command="{Binding SetMapKindCommand}" CommandParameter="staged" Tag="{Binding MapKind, Converter={StaticResource Eq}, ConverterParameter=staged}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource FilterLabel}" Text="SHOW" Margin="0,0,8,6" />
                                <Border CornerRadius="7" Background="{StaticResource Bg2Brush}" Padding="2" Margin="0,0,20,6"
                                        ToolTip="Maps you've finished on KSF (this tick rate), or the ones you haven't yet" ToolTipService.InitialShowDelay="700">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SegmentButton}" Content="All" Command="{Binding SetMapDoneCommand}" CommandParameter="all" Tag="{Binding MapDone, Converter={StaticResource Eq}, ConverterParameter=all}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Not done" Command="{Binding SetMapDoneCommand}" CommandParameter="todo" Tag="{Binding MapDone, Converter={StaticResource Eq}, ConverterParameter=todo}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Done" Command="{Binding SetMapDoneCommand}" CommandParameter="done" Tag="{Binding MapDone, Converter={StaticResource Eq}, ConverterParameter=done}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource FilterLabel}" Text="SORT" Margin="0,0,8,6" />
                                <Border CornerRadius="7" Background="{StaticResource Bg2Brush}" Padding="2" Margin="0,0,20,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SegmentButton}" Content="Popular" Command="{Binding SetMapSortCommand}" CommandParameter="popular" Tag="{Binding MapSort, Converter={StaticResource Eq}, ConverterParameter=popular}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Newest" Command="{Binding SetMapSortCommand}" CommandParameter="newest" Tag="{Binding MapSort, Converter={StaticResource Eq}, ConverterParameter=newest}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Tier" Command="{Binding SetMapSortCommand}" CommandParameter="tier" Tag="{Binding MapSort, Converter={StaticResource Eq}, ConverterParameter=tier}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="A-Z" Command="{Binding SetMapSortCommand}" CommandParameter="name" Tag="{Binding MapSort, Converter={StaticResource Eq}, ConverterParameter=name}" />
                                        <Button Style="{StaticResource SegmentButton}" Content="Rating" Command="{Binding SetMapSortCommand}" CommandParameter="rating" Tag="{Binding MapSort, Converter={StaticResource Eq}, ConverterParameter=rating}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding MapResults}" ItemTemplate="{StaticResource MapTileTemplate}" Focusable="False" Margin="0,0,0,16"
                                      Visibility="{Binding IsTileView, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:TilePanel MinItemWidth="{Binding TileSize}" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Style="{StaticResource Card}" Padding="10" Visibility="{Binding IsListView, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding MapResults}" ItemTemplate="{StaticResource MapListTemplate}" Focusable="False" />
                        </Border>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,2,0,0" Command="{Binding ShowMoreMapsCommand}"
                                Visibility="{Binding HasMoreMaps, Converter={StaticResource Vis}}" Content="Show more maps" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ Binds page: KSF commands and turning on keys - run from the console, never typed in chat ============ -->
            <Grid x:Name="BindsPage" Grid.Row="2" Margin="20,6,20,8" Visibility="{Binding IsBindsPage, Converter={StaticResource Vis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="18,14,18,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Binds.Status}" FontSize="12" Margin="16,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Binds" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" FontSize="12.5"
                                           Text="Put KSF's commands on keys. They run from the console, so nothing is typed in chat for anyone - KSF's answer (like your saved location) only shows for you. Click a key button, then press the key; a key gets back what it did before when you take the bind off." />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,14,0,0">
                            <TextBox x:Name="BindSearchBox" Style="{StaticResource SearchBox}" Text="{Binding Binds.Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Text2Brush}" Margin="13,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock Text="Search binds - restart, stage, saveloc, turn, a key..." Foreground="{StaticResource Text2Brush}" FontSize="14" Margin="37,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="{Binding Binds.HasSearch, Converter={StaticResource NotVis}}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,5,0"
                                    Command="{Binding Binds.ClearSearchCommand}" Visibility="{Binding Binds.HasSearch, Converter={StaticResource Vis}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Binds.Groups}" Focusable="False" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ui:ColumnsPanel MinItemWidth="560" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0" Padding="18,14,18,10" VerticalAlignment="Top">
                                    <!-- VIP commands get a gold outline and a badge. -->
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVip}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#B3E8B84A" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                    <Setter Property="Background" Value="#120E0C06" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border CornerRadius="5" Background="#26E8B84A" BorderBrush="#80E8B84A" BorderThickness="1" Padding="7,1" Margin="0,0,9,0"
                                                    VerticalAlignment="Center" Visibility="{Binding IsVip, Converter={StaticResource Vis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#E8B84A" VerticalAlignment="Center" />
                                                    <TextBlock Text="VIP" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11" Foreground="#E8B84A" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}"
                                                       Visibility="{Binding IsVip, Converter={StaticResource NotVis}}" />
                                            <TextBlock Style="{StaticResource Muted}" Text="For KSF VIP members - the server ignores these without VIP" FontSize="11.5"
                                                       Visibility="{Binding IsVip, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BindRowTemplate}" Focusable="False" />
                                        <!-- How fast the turn keys turn (cl_yawspeed). -->
                                        <DockPanel Margin="0,8,0,4" Visibility="{Binding HasTurnSpeed, Converter={StaticResource Vis}}"
                                                   ToolTip="How fast the turn keys turn (cl_yawspeed; the game's default is 210)" ToolTipService.InitialShowDelay="500">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DataContext.Binds.TurnSpeedText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontFamily="{StaticResource DisplayFont}" FontSize="13" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource FilterLabel}" Text="TURN SPEED" Width="90" VerticalAlignment="Center" Margin="0" />
                                            <Slider Style="{StaticResource SizeSlider}" Minimum="50" Maximum="600" SmallChange="5" LargeChange="25" VerticalAlignment="Center" Margin="4,0,8,0"
                                                    Value="{Binding DataContext.Binds.TurnSpeed, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DockPanel>
                                        <!-- Any other command, e.g. sm_stage 2 or !b 1. -->
                                        <DockPanel Margin="0,6,0,4" Visibility="{Binding IsOwn, Converter={StaticResource Vis}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Add" Padding="16,7" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.Binds.AddOwnCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Grid>
                                                <TextBox x:Name="OwnBox" Style="{StaticResource SearchBox}" Padding="12,7,12,7" FontSize="13"
                                                         Text="{Binding DataContext.Binds.OwnCommand, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding DataContext.Binds.AddOwnCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Text="Any other command, like sm_stage 2 or !b 1" Foreground="{StaticResource Text2Brush}" FontSize="13" Margin="14,0,0,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=OwnBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ Content ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding IsDashboardPage, Converter={StaticResource Vis}}">
                <Grid x:Name="Columns" Margin="20,12,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition x:Name="RightColumn" Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== Left: the map you're on ===== -->
                    <StackPanel x:Name="LeftPanel" Grid.Column="0">

                        <ContentControl Style="{StaticResource Part}" Tag="map" Visibility="{Binding Layout[map], Converter={StaticResource Vis}}">
                        <Grid x:Name="Hero" Height="300" Margin="0,0,0,16">
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#221610" Offset="0" />
                                        <GradientStop Color="#0E0E12" Offset="0.65" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="HeroImage" CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding MapImage}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5507070A" Offset="0" />
                                        <GradientStop Color="#0007070A" Offset="0.32" />
                                        <GradientStop Color="#B007070A" Offset="0.72" />
                                        <GradientStop Color="#F207070A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="16" BorderBrush="#1FFFFFFF" BorderThickness="1" />

                            <Grid x:Name="HeroContent" Margin="26,22,26,24">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="HeroShift" />
                                </Grid.RenderTransform>

                                <DockPanel VerticalAlignment="Top" LastChildFill="False">
                                    <Border DockPanel.Dock="Left" CornerRadius="6" Background="#A6000000" Padding="9,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Text="{Binding MapBadge}" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border DockPanel.Dock="Left" Margin="8,0,0,0" CornerRadius="7" Background="#A6000000" Padding="2"
                                            Visibility="{Binding HasMap, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentButton}" Content="66T" Command="{Binding TickCommand}" CommandParameter="css"
                                                    Tag="{Binding Is100t, Converter={StaticResource Not}}" />
                                            <Button Style="{StaticResource SegmentButton}" Content="100T" Command="{Binding TickCommand}" CommandParameter="css100t"
                                                    Tag="{Binding Is100t}" />
                                        </StackPanel>
                                    </Border>
                                    <Border DockPanel.Dock="Left" Margin="8,0,0,0" CornerRadius="6" Background="#A6000000" Padding="9,4"
                                            Visibility="{Binding HasServerLine, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding ServerLine}" FontSize="12" Foreground="{StaticResource Text1Brush}" />
                                    </Border>
                                    <Border DockPanel.Dock="Left" Margin="8,0,0,0" CornerRadius="6" Background="#A6000000" Padding="9,4"
                                            Visibility="{Binding Loading, Converter={StaticResource Vis}}">
                                        <TextBlock Text="asking ksf.surf..." FontSize="12" Foreground="{StaticResource Text1Brush}" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Background="#A6000000" Padding="9,4"
                                            Visibility="{Binding HasRating, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="#F5C542" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RatingText}" Margin="6,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <!-- KSF announces the next map in chat near the end (or when a vote finishes). -->
                                    <Border DockPanel.Dock="Right" Margin="0,0,8,0" CornerRadius="6" Background="#A6000000" Padding="9,4"
                                            Visibility="{Binding HasNextMap, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="NEXT" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NextMap}" Margin="7,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>

                                <Grid VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="MapTitle" Text="{Binding MapName}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="46"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsOnKsf, Converter={StaticResource Vis}}">
                                            <Border Style="{StaticResource Chip}" Background="{Binding TierSoftBrush}">
                                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding TierText}" Foreground="{Binding TierBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="#C0141418">
                                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding TypeText}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="#C0141418">
                                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding BonusText}" />
                                            </Border>
                                            <TextBlock Text="{Binding MapperText}" Foreground="{StaticResource Text1Brush}" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Text1Brush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding IsOnKsf, Converter={StaticResource NotVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                        <!-- The time left on the map, big, across from the map's name: the limit and how much it's been extended under it. -->
                                        <ContentControl Style="{StaticResource Part}" Tag="timer" HorizontalAlignment="Right" Margin="0,0,0,14"
                                                        Visibility="{Binding Layout[timer], Converter={StaticResource Vis}}">
                                            <!-- A small frosted panel: status dot and label, thin digits, a hairline of the map's time, the limit and extends. -->
                                            <Border x:Name="HeroClock" Width="214" CornerRadius="14" Background="#8C0A0A0E" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                    Padding="18,12,18,13" Visibility="{Binding HasHeroTime, Converter={StaticResource Vis}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding HeroAccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding HeroTimeLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Text2Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="HeroClockText" Text="{Binding HeroTimeBig}" FontFamily="{StaticResource DisplayFont}" FontSize="50" FontWeight="Light"
                                                               Foreground="{Binding HeroTimeBrush}" Typography.NumeralAlignment="Tabular" Margin="-2,0,0,0" />
                                                    <Grid Height="2" Margin="0,4,0,0">
                                                        <Border CornerRadius="1" Background="#1AFFFFFF" />
                                                        <Border CornerRadius="1" Background="{Binding HeroAccentBrush}" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding HeroTimeFraction}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ExtendInfo}" FontSize="11.5" Foreground="{StaticResource Text2Brush}" Margin="0,9,0,0"
                                                               TextWrapping="Wrap" Visibility="{Binding HasExtendInfo, Converter={StaticResource Vis}}" />
                                                </StackPanel>
                                            </Border>
                                        </ContentControl>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasMap, Converter={StaticResource Vis}}">
                                            <Button Style="{StaticResource GhostButton}" Background="#A6000000" Command="{Binding OpenMapCommand}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" />
                                                    <TextBlock Text="ksf.surf" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaved, Converter={StaticResource Not}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE735;" />
                                                    <TextBlock Text="{Binding SaveLabel}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>



                            <!-- PB / first finish / WR: plays for a few seconds right when the timer says you finished -->
                            <Grid x:Name="Celebration" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border CornerRadius="16" Background="#B307070A" />
                                <Border CornerRadius="16">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.7" RadiusY="0.95">
                                            <GradientStop Color="#99FF7A1A" Offset="0" />
                                            <GradientStop Color="#33FF7A1A" Offset="0.5" />
                                            <GradientStop Color="#00FF7A1A" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="16" BorderBrush="#99FF7A1A" BorderThickness="1.5" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <ScaleTransform x:Name="CelebrationScale" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#FFD27A" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CelebrationTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="40"
                                               HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#FF7A1A" Opacity="0.85" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CelebrationDetail}" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource Text0Brush}"
                                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </ContentControl>

                        <!-- stat tiles -->
                        <ContentControl Style="{StaticResource Part}" Tag="numbers" Visibility="{Binding Layout[numbers], Converter={StaticResource Vis}}">
                        <UniformGrid x:Name="Tiles" Columns="4" Margin="0,0,-12,4" Visibility="{Binding IsOnKsf, Converter={StaticResource Vis}}">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="WORLD RECORD" />
                                    <TextBlock Style="{StaticResource Numbers}" Text="{Binding WrTime}" FontSize="30" FontWeight="SemiBold" Foreground="#F5C542" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding WrHolder}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding WrDate}" Margin="0,2,0,0" Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="YOUR BEST" />
                                    <TextBlock Style="{StaticResource Numbers}" Text="{Binding PbTime}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding PbRank}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <StackPanel Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}">
                                        <Grid Height="4" Margin="0,9,0,0" Visibility="{Binding HasPb, Converter={StaticResource Vis}}">
                                            <Border CornerRadius="2" Background="{StaticResource Bg3Brush}" />
                                            <Border CornerRadius="2" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding PbBar}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding PbTop}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="GAP TO WR" />
                                    <TextBlock Style="{StaticResource Numbers}" Text="{Binding GapTime}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding GapDetail}" Margin="0,4,0,0" FontSize="12.5"
                                               Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}" />
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource GoodSoftBrush}" HorizontalAlignment="Left" Margin="0,9,0,0"
                                            Visibility="{Binding HasGroup, Converter={StaticResource Vis}}">
                                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding GroupText}" Foreground="{StaticResource GoodBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" ToolTipService.InitialShowDelay="700"
                                    ToolTip="Finishes count the moment you finish. Attempts and time on the map are KSF's own counts - ksf.surf updates them a few minutes later, so they can tick up while you stand still.">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="FINISHES" />
                                    <TextBlock Style="{StaticResource Numbers}" Text="{Binding Finishes}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Attempts}" FontSize="13" Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Playtime}" Margin="0,2,0,0" Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        </ContentControl>

                        <!-- your times: the map, every stage and every bonus - time, gap to the record, your place on each leaderboard -->
                        <ContentControl Style="{StaticResource Part}" Tag="times" Visibility="{Binding Layout[times], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasTimes, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Muted}" DockPanel.Dock="Right" Text="bar: how close you are to the record (full = record pace)" FontSize="11.5"
                                               Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="YOUR TIMES" />
                                </DockPanel>
                                <ContentControl Content="{Binding MapRow}" ContentTemplate="{StaticResource ZoneRowTemplate}" Focusable="False" />

                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasStages, Converter={StaticResource Vis}}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource Muted}" DockPanel.Dock="Right" Text="{Binding StagesSummary}" FontSize="11.5"
                                                   Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}" />
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="STAGES" FontSize="11" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="StageColumnB" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl ItemsSource="{Binding StagesA}" ItemTemplate="{StaticResource ZoneRowTemplate}" Focusable="False" />
                                        <ItemsControl x:Name="StagesRight" Grid.Column="1" Margin="28,0,0,0" ItemsSource="{Binding StagesB}"
                                                      ItemTemplate="{StaticResource ZoneRowTemplate}" Focusable="False" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasBonuses, Converter={StaticResource Vis}}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource Muted}" DockPanel.Dock="Right" Text="{Binding BonusesSummary}" FontSize="11.5"
                                                   Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}" />
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="BONUSES" FontSize="11" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="BonusColumnB" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl ItemsSource="{Binding BonusesA}" ItemTemplate="{StaticResource ZoneRowTemplate}" Focusable="False" />
                                        <ItemsControl x:Name="BonusesRight" Grid.Column="1" Margin="28,0,0,0" ItemsSource="{Binding BonusesB}"
                                                      ItemTemplate="{StaticResource ZoneRowTemplate}" Focusable="False" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <!-- leaderboard -->
                        <ContentControl Style="{StaticResource Part}" Tag="leaderboard" Visibility="{Binding Layout[leaderboard], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsOnKsf, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Muted}" DockPanel.Dock="Right" Text="{Binding FinishersText}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="LEADERBOARD" />
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding LeaderHeading}" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" />
                                        <!-- It follows where you are (the map, or the bonus you're on) unless you picked another one. -->
                                        <Button Style="{StaticResource GhostButton}" Padding="8,2" Margin="12,0,0,0" FontSize="11"
                                                Command="{Binding FollowLeaderboardCommand}" Visibility="{Binding LeaderPinned, Converter={StaticResource Vis}}"
                                                ToolTip="Show the leaderboard of where you are again" ToolTipService.InitialShowDelay="700">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE81D;" FontSize="10" />
                                                <TextBlock Text="follow me" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding LeaderChips}" Margin="0,0,0,8" Focusable="False"
                                              Visibility="{Binding HasLeaderChoices, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LeaderChipButton}"
                                                    Command="{Binding DataContext.SelectLeaderboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Zone}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Muted}" Text="Loading..." Visibility="{Binding Loading, Converter={StaticResource Vis}}" />
                                <TextBlock Style="{StaticResource Muted}" Text="Loading..." Visibility="{Binding LeaderLoading, Converter={StaticResource Vis}}" />
                                <ItemsControl ItemsSource="{Binding Leaders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock x:Name="gap" Text="&#x00B7;&#x00B7;&#x00B7;" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center"
                                                           FontSize="14" Margin="0,0,0,2" Visibility="Collapsed" />
                                                <Border x:Name="row" Style="{StaticResource Row}" Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Numbers}" Text="{Binding Rank}" Foreground="{Binding RankBrush}" FontWeight="SemiBold" FontSize="14" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13.5" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Numbers}" Text="{Binding Time}" FontSize="14.5" />
                                                        <TextBlock Grid.Column="3" Style="{StaticResource Numbers}" Text="{Binding Gap}" Foreground="{StaticResource Text2Brush}"
                                                                   FontSize="12.5" HorizontalAlignment="Right"
                                                                   Visibility="{Binding DataContext.Layout.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsYou}" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="row" Property="BorderBrush" Value="#66FF7A1A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGap}" Value="True">
                                                    <Setter TargetName="row" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="gap" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <!-- in-game keys (help, so not in the Simple view) -->
                        <ContentControl Style="{StaticResource Part}" Tag="keys" Visibility="{Binding Layout[keys], Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal" Margin="4,2,0,16" Opacity="0.85" Visibility="{Binding Layout.IsAdvanced, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Muted}" Text="In game" Margin="0,0,12,0" />
                            <Border Style="{StaticResource KeyCap}"><TextBlock x:Name="SaveKey" Text="F5" FontFamily="{StaticResource DisplayFont}" FontSize="11" /></Border>
                            <TextBlock Style="{StaticResource Muted}" Text="save map" Margin="0,0,16,0" />
                            <Border Style="{StaticResource KeyCap}"><TextBlock x:Name="CardKey" Text="F6" FontFamily="{StaticResource DisplayFont}" FontSize="11" /></Border>
                            <TextBlock Style="{StaticResource Muted}" Text="hold for the map card" Margin="0,0,16,0" />
                            <Border Style="{StaticResource KeyCap}"><TextBlock x:Name="ListKey" Text="F7" FontFamily="{StaticResource DisplayFont}" FontSize="11" /></Border>
                            <TextBlock Style="{StaticResource Muted}" Text="hold for your list" />
                        </StackPanel>
                        </ContentControl>
                    </StackPanel>

                    <!-- ===== Right: your server live, this session, play later, servers, recent ===== -->
                    <StackPanel x:Name="RightPanel" Grid.Column="1" Margin="16,0,0,0">

                        <!-- The KSF server you're on, from ksf.surf every 15 s: who's there and which stage they're on. -->
                        <ContentControl Style="{StaticResource Part}" Tag="live" Visibility="{Binding Layout[live], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}" BorderBrush="#40FF7A1A" Visibility="{Binding HasLiveServer, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Numbers}" Text="{Binding LiveTimeLeft}" FontSize="13"
                                               Foreground="{StaticResource Text1Brush}" Visibility="{Binding HasLiveTime, Converter={StaticResource Vis}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="5" Background="{StaticResource AccentSoftBrush}" Padding="7,2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <TextBlock Text="LIVE" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding LiveTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding LiveSubtitle}" FontSize="12.5" Margin="0,7,0,0" />
                                <Grid Height="3" Margin="0,11,0,8" Visibility="{Binding HasLiveTime, Converter={StaticResource Vis}}">
                                    <Border CornerRadius="1.5" Background="{StaticResource Bg3Brush}" />
                                    <Border CornerRadius="1.5" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding LiveTimeFraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LivePlayers}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ui:LimitPanel MaxItems="{Binding LiveLimit}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Style="{StaticResource Row}" Padding="8,5" Margin="-8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="zone" CornerRadius="5" Padding="6,1" Background="{Binding ZoneSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Zone}" Foreground="{Binding ZoneBrush}" FontSize="10.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                                    </Border>
                                                    <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Numbers}" Text="{Binding Rank}" Foreground="{StaticResource Text2Brush}" FontSize="12"
                                                               Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource Numbers}" Text="{Binding Connected}" Foreground="{StaticResource Text2Brush}" FontSize="12"
                                                               HorizontalAlignment="Right" ToolTip="Time on the server" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsYou}" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasZone}" Value="False">
                                                    <Setter TargetName="zone" Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding LiveSpectators}" FontSize="11.5" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <!-- This run of the game: how long, how many maps, finishes and PBs. -->
                        <ContentControl Style="{StaticResource Part}" Tag="session" Visibility="{Binding Layout[session], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}" Padding="18,14" Visibility="{Binding HasSession, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SessionTitle}" />
                                <UniformGrid Columns="4" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Numbers}" Text="{Binding SessionTime}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource Muted}" Text="played" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Numbers}" Text="{Binding SessionMaps}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding SessionMapsLabel}" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Numbers}" Text="{Binding SessionFinishes}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding SessionFinishesLabel}" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Numbers}" Text="{Binding SessionPbs}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Left"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding SessionPbsLabel}" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <!-- Your KSF title (the tag in front of your name in chat) on 66 and 100 tick, and how far off the next one is. -->
                        <ContentControl Style="{StaticResource Part}" Tag="level" Visibility="{Binding Layout[level], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}" Padding="18,14" Visibility="{Binding HasLevels, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="YOUR LEVEL" />
                                <ItemsControl ItemsSource="{Binding Levels}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,12,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Numbers}" Text="{Binding Standing}" FontSize="13" VerticalAlignment="Center" />
                                                    <Border x:Name="tick" CornerRadius="5" Background="{StaticResource Bg3Brush}" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="tickText" Text="{Binding Tick}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource Text1Brush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <Grid Height="6" Margin="0,9,0,0">
                                                    <Border CornerRadius="3" Background="{StaticResource Bg3Brush}" />
                                                    <Border x:Name="bar" CornerRadius="3" Background="#8CFF7A1A" RenderTransformOrigin="0,0.5" ui:BarFill.Value="{Binding Progress}" />
                                                </Grid>
                                                <DockPanel Margin="0,7,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Extra}" FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding DataContext.Layout.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />
                                                    <TextBlock Text="{Binding Next}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding NextDetail}" FontSize="11.5" Margin="0,2,0,0"
                                                           Visibility="{Binding DataContext.Layout.IsAdvanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <!-- The tick rate you're playing on stands out. -->
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="tick" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="tickText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="bar" Property="Background" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Part}" Tag="later" Visibility="{Binding Layout[later], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open the folder with play-later.txt and settings.ini"
                                            Command="{Binding OpenFolderCommand}" Width="26" Height="26" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="PLAY LATER" />
                                        <Border Margin="8,0,0,0" CornerRadius="5" Background="{StaticResource Bg3Brush}" Padding="6,1" VerticalAlignment="Center"
                                                Visibility="{Binding HasLater, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding LaterCount}" FontFamily="{StaticResource DisplayFont}" FontSize="11" Foreground="{StaticResource Text1Brush}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" FontSize="12.5" Margin="0,0,0,4"
                                           Text="Nothing saved yet. Press F5 while you're on a map you want to come back to, or use Save for later above."
                                           Visibility="{Binding HasLater, Converter={StaticResource NotVis}}" />
                                <ItemsControl ItemsSource="{Binding Later}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Style="{StaticResource Row}" Margin="0,0,0,4">
                                                <Grid>
                                                <Border x:Name="hover" CornerRadius="9" Background="#0CFFFFFF" Opacity="0" />
                                                <Grid Margin="7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="96" Height="54">
                                                        <Border CornerRadius="7" Background="{StaticResource Bg3Brush}" />
                                                        <Border CornerRadius="7">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Map}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border CornerRadius="5" Padding="6,1" Background="{Binding TierSoftBrush}">
                                                                <TextBlock Text="{Binding Tier}" Foreground="{Binding TierBrush}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                                            </Border>
                                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Saved}" Margin="8,0,0,0" FontSize="11.5" />
                                                            <TextBlock x:Name="here" Text="playing now" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Margin="8,0,0,0"
                                                                       VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="live" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                                                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoodBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Live}" Foreground="{StaticResource GoodBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <StackPanel x:Name="actions" Orientation="Horizontal" Opacity="0.4">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE724;" ToolTip="Nominate - sent straight to the KSF server you're on, otherwise copied for chat"
                                                                    Command="{Binding DataContext.NominateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open on ksf.surf"
                                                                    Command="{Binding DataContext.OpenLaterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from the list"
                                                                    Command="{Binding DataContext.RemoveLaterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Map}" />
                                                        </StackPanel>
                                                        <Button x:Name="join" Style="{StaticResource AccentButton}" Padding="12,5" Margin="4,0,0,0" Visibility="Collapsed"
                                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JoinAddress}">
                                                            <TextBlock Text="Join" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter TargetName="live" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="join" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="here" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="row" Property="BorderBrush" Value="#55FF7A1A" />
                                                </DataTrigger>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetName="actions" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                                <DoubleAnimation Storyboard.TargetName="actions" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.25" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Part}" Tag="servers" Visibility="{Binding Layout[servers], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Muted}" DockPanel.Dock="Right" Text="{Binding ServersUpdated}" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="KSF SERVERS" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Loading servers..." Visibility="{Binding HasServers, Converter={StaticResource NotVis}}" />
                                <ItemsControl ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ui:LimitPanel MaxItems="{Binding ServerLimit}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Style="{StaticResource Row}">
                                                <Grid>
                                                <Border x:Name="hover" CornerRadius="9" Background="#0CFFFFFF" Opacity="0" />
                                                <Grid Margin="10,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="146" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Text1Brush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="you" Text="YOU'RE HERE" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource DisplayFont}"
                                                                   FontSize="10" FontWeight="SemiBold" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border CornerRadius="5" Padding="6,1" Background="{Binding TierSoftBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Tier}" Foreground="{Binding TierBrush}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Map}" Margin="8,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="star" Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="#F5C542" FontSize="11"
                                                                   Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Text2Brush}" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Style="{StaticResource Numbers}" Text="{Binding Players}" Margin="6,0,0,0" FontSize="13" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Style="{StaticResource Muted}" Text="{Binding TimeLeft}" TextAlignment="Right" HorizontalAlignment="Right" />
                                                    <Button x:Name="join" Grid.Column="4" Style="{StaticResource GhostButton}" Padding="10,4" Margin="10,0,0,0" Opacity="0.35"
                                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Address}">
                                                        <TextBlock Text="Join" />
                                                    </Button>
                                                </Grid>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                    <Setter TargetName="star" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsYours}" Value="True">
                                                    <Setter TargetName="you" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="row" Property="BorderBrush" Value="#55FF7A1A" />
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetName="join" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                                <DoubleAnimation Storyboard.TargetName="join" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.25" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Part}" Tag="recent" Visibility="{Binding Layout[recent], Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="YOUR RECENT RECORDS" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource Muted}" Text="Nothing yet - your new PRs and groups on KSF show up here."
                                           Visibility="{Binding HasRecent, Converter={StaticResource NotVis}}" />
                                <ItemsControl ItemsSource="{Binding Recent}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ui:LimitPanel MaxItems="{Binding RecentLimit}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="94" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="5" Padding="7,2" Background="{Binding KindSoftBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Kind}" Foreground="{Binding KindBrush}" FontSize="10.5" FontWeight="SemiBold"
                                                               FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Map}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" FontSize="11.5" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Numbers}" Text="{Binding Time}" FontSize="13.5" VerticalAlignment="Top" Margin="10,1,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </ContentControl>
                    </StackPanel>

                    <!-- Everything hidden: say how to bring it back. -->
                    <StackPanel x:Name="NothingShown" Grid.ColumnSpan="2" Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Everything's hidden" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" Text="Customize, at the top right, brings parts back." FontSize="13" Margin="0,6,0,14" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource AccentButton}" Content="Show everything" Command="{Binding ShowAllPartsCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- toast -->
            <Border x:Name="ToastHost" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                    CornerRadius="10" Background="#F21C1C24" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                    Padding="16,10" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="12.5" />
            </Border>
        </Grid>
    </Border>
</Window>