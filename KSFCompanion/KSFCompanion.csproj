<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Linux build: Avalonia instead of WPF. Publish it as one self-contained file (see README-linux.md). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KSFCompanion</AssemblyName>
    <RootNamespace>KsfCompanion</RootNamespace>
    <Version>3.2.1</Version>
    <Product>KSF Companion</Product>
    <Description>KSF surf dashboard for your second monitor, plus in-game map info and a play-later list for CS:S.</Description>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <!-- Numbers are shown the way the Windows build's screenshots show them (4,936), whatever the system locale. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- The window finds its named parts itself. -->
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!-- Only for the preview command, which draws the dashboard to a PNG without a window. -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Ui\Assets\icon-*.png;Ui\Assets\Fonts\*.ttf" />
    <None Remove="Ui\Assets\app.ico" />
  </ItemGroup>

</Project>
